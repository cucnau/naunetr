rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /novels/{novelId} {
      allow read, write: if isAuthenticated();
    }
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    match /customTerms/{termId} {
      allow read, write: if isAuthenticated();
    }
    match /characters/{characterId} {
      allow read, write: if isAuthenticated();
    }
    match /relationships/{relationshipId} {
      allow read, write: if isAuthenticated();
    }
    match /chapters/{chapterId} {
      allow read, write: if isAuthenticated();
    }
    match /activeSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }
    match /shortcuts/{shortcutId} {
      allow read, write: if isAuthenticated();
    }
    match /histories/{historyId} {
      allow get: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}


